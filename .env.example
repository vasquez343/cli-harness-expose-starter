# Generate: uv run agentd token. Never commit a real value.
AGENTD_TOKEN=
HARNESS_PROVIDER=codex
HARNESS_WORKSPACE=./workspace
# Required opt-in: runs the CLI with its internal approval/sandbox bypass.
# Enable only after evaluating OS/container isolation for your use case.
HARNESS_ALLOW_UNSAFE_CLI=0
HARNESS_IDLE_TIMEOUT=120
HARNESS_TOTAL_TIMEOUT=900
HARNESS_MAX_OUTPUT_BYTES=8388608
# Additional environment variables the CLI needs (comma separated).
# AGENTD_TOKEN is never forwarded, even if named here.
HARNESS_ENV_ALLOWLIST=
